# Local datasets and generated dataset artifacts are intentionally not committed.
# Raw/versioned data will move to lakeFS + object storage in later milestones.
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep
data/manifests/**
!data/manifests/.gitkeep
